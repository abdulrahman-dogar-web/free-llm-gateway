# Free LLM Gateway — environment variables (copy to .env; never commit .env)
# All of these are optional. config.json is the primary way to add providers.

# Port the gateway listens on (default: 8787)
PORT=8787

# Host to bind to. Keep 127.0.0.1 (localhost only) unless you know what you are
# doing — the dashboard has no login, so binding to 0.0.0.0 exposes it.
HOST=127.0.0.1

# Path to the JSON config file with your providers (default: ./config.json)
# CONFIG_PATH=./config.json

# Directory for local state: unified keys, usage log, provider state
# (default: ./data)
# DATA_DIR=./data

# How long (seconds) a provider stays in cooldown after a 429 / quota error
# before it is tried again (default: 60)
# COOLDOWN_SECONDS=60

# Request timeout per provider attempt, in milliseconds (default: 60000)
# REQUEST_TIMEOUT_MS=60000
